<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.tools.dashboard</groupId>
        <artifactId>forge-dashboard-parent</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>forge-dashboard-app</artifactId>
    <name>forge-dashboard :: app</name>
    <description>Vaadin Flow UI on the Vidocq runtime (Foy servlet container)</description>

    <properties>
        <!-- The runtime's own main boots this module: no main class. -->
        <vidocq.mainModule>io.vidocq.tools.dashboard</vidocq.mainModule>
        <!-- Vaadin production mode with the precompiled frontend of vaadin-prod-bundle: no Node needed. -->
        <vidocq.dev.jvmArgs>-Dvaadin.productionMode=true</vidocq.dev.jvmArgs>
        <vidocq.run.jvmArgs>-Dvaadin.productionMode=true</vidocq.run.jvmArgs>
        <vidocq.jvmArgs>-Dvaadin.productionMode=true</vidocq.jvmArgs>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-foy-servlet-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-vaadin-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
            <artifactId>vidocq-runtime-ravel-config-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
            <artifactId>vidocq-runtime-cyrano-rest-client-extension</artifactId>
        </dependency>
        <!-- MicroProfile JWT: validation of the CodeFloe id_token (signature, issuer, audience, expiry). -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
            <artifactId>vidocq-runtime-cervantes-jwt-extension</artifactId>
        </dependency>

        <!-- PostgreSQL: the Mansart pool, Jakarta Data repositories, JTA, and the Flyway migrations. -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-mansart-pool-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-mansart-data-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-mansart-transactions-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.essentials</groupId>
            <artifactId>vidocq-runtime-flyway-migration-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-core</artifactId>
        </dependency>
        <!-- The precompiled frontend of the core components. -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-prod-bundle</artifactId>
            <version>${vaadin.version}</version>
        </dependency>
        <!-- Vaadin logs through SLF4J: without a provider it is silent. This one writes to java.util.logging. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- One PostgreSQL container for the whole test run, its coordinates injected as vidocq.pool.* system
             properties. Not required by module-info.java: Surefire leaves it on the class path, where the
             ServiceLoader of the JUnit launcher finds it. -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-devservices-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-devservice-postgres</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-maven-plugin</artifactId>
                <version>${vaadin.version}</version>
                <executions>
                    <execution>
                        <id>prepare-frontend</id>
                        <goals>
                            <goal>prepare-frontend</goal>
                        </goals>
                    </execution>
                    <!-- Bound to process-classes: vidocq:run and vidocq:dev never reach prepare-package. -->
                    <execution>
                        <id>build-frontend</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>build-frontend</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-maven-plugin</artifactId>
                <version>${vidocq.version}</version>
                <extensions>true</extensions>
                <!-- vidocq:dev starts a PostgreSQL container when no vidocq.pool.url is given. -->
                <dependencies>
                    <dependency>
                        <groupId>io.vidocq.runtime</groupId>
                        <artifactId>vidocq-runtime-devservice-postgres</artifactId>
                        <version>${vidocq.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
