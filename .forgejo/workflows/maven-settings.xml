<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              http://maven.apache.org/xsd/settings-1.0.0.xsd">

    <!-- Credentials Reposilite Vidocq pour les SNAPSHOTs upstream
         (cassini, chappe, vauban, champollion, ravel, vidocq-runtime, ...).
         Injectees depuis les secrets Forgejo Actions :
           VIDOCQ_MAVEN_USER / VIDOCQ_MAVEN_PASSWORD -->
    <servers>
        <server>
            <id>vidocq-snapshots</id>
            <username>${env.VIDOCQ_MAVEN_USER}</username>
            <password>${env.VIDOCQ_MAVEN_PASSWORD}</password>
        </server>
        <server>
            <id>vidocq-releases</id>
            <username>${env.VIDOCQ_MAVEN_USER}</username>
            <password>${env.VIDOCQ_MAVEN_PASSWORD}</password>
        </server>
    </servers>
</settings>
